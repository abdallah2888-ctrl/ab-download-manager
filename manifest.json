{
  "manifest_version": 3,
  "name": "NovaGet Downloader Bridge",
  "version": "2.2.0",
  "description": "التقاط التحميلات وإضافة زر تحميل الفيديو في يوتيوب وإرسالها إلى NovaGet",
  "permissions": ["downloads", "storage", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
